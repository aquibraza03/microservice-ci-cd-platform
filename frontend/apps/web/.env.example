/**
 * Environment template for the web application.
 * Copy to `.env.local` and adjust. Defaults live in `@saas/lib` env resolver;
 * nothing here is required for local development.
 */
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Enterprise SaaS Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENABLED=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_API_RETRIES=2

# Auth provider: guest | dev | jwt (dev is development-only)
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_PROVIDER=dev
NEXT_PUBLIC_AUTH_LOGIN_URL=/auth/login
NEXT_PUBLIC_AUTH_LOGOUT_URL=/auth/logout
NEXT_PUBLIC_AUTH_REFRESH_URL=/auth/refresh
NEXT_PUBLIC_AUTH_USERINFO_URL=/auth/me
NEXT_PUBLIC_AUTH_OAUTH_AUTHORIZE_URL=
NEXT_PUBLIC_AUTH_OAUTH_TOKEN_URL=
NEXT_PUBLIC_AUTH_OAUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_OAUTH_SCOPES=openid profile email
NEXT_PUBLIC_AUTH_REDIRECT_PATH=/dashboard
NEXT_PUBLIC_AUTH_SESSION_TTL_MS=1800000

NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Optional Phase 10 Part 2 contracts. Leave empty until backend support exists.
NEXT_PUBLIC_SEARCH_URL=
NEXT_PUBLIC_NOTIFICATIONS_URL=
NEXT_PUBLIC_NOTIFICATION_READ_URL=
NEXT_PUBLIC_NOTIFICATIONS_READ_ALL_URL=
NEXT_PUBLIC_ORGANIZATIONS_URL=/v1/organizations
NEXT_PUBLIC_ORGANIZATION_PROJECTS_URL=/v1/organizations/{organizationId}/projects
NEXT_PUBLIC_ORGANIZATION_PROJECT_URL=/v1/organizations/{organizationId}/projects/{id}
NEXT_PUBLIC_ORGANIZATION_REPOSITORIES_URL=/v1/organizations/{organizationId}/repositories
NEXT_PUBLIC_ORGANIZATION_ENVIRONMENTS_URL=/v1/organizations/{organizationId}/environments

# Feature flags
NEXT_PUBLIC_FEATURE_REGISTRY=false
NEXT_PUBLIC_FEATURE_OBSERVABILITY=false
NEXT_PUBLIC_FEATURE_CI_CD=false
