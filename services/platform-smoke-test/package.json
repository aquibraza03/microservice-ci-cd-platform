{
  "name": "platform-smoke-test",
  "version": "1.0.0",
  "private": true,
  "description": "Platform validation smoke test service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "c8 mocha 'test/unit/**/*.js' --reporter spec --timeout 5000",
    "test:integration": "c8 mocha 'test/integration/**/*.js' --reporter spec --timeout 10000",
    "test:e2e": "bash test/e2e/health-check.sh",
    "test:all": "npm test && npm run test:integration && npm run test:e2e"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6"
  }
}
