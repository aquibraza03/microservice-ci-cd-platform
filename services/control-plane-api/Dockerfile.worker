FROM node:20-alpine@sha256:afdf98210b07b586eb71fa22ba2e432e058e4cd1304d31ed60888755b8c865fb AS deps

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev


FROM aquasec/trivy:0.66.0 AS trivy
FROM anchore/syft:v1.33.0 AS syft
FROM gcr.io/projectsigstore/cosign:v2.6.0 AS cosign
FROM ghcr.io/yannh/kubeconform:v0.7.0 AS kubeconform
FROM registry.k8s.io/kubectl:v1.34.1 AS kubectl

# BuildKit client + daemonless script
FROM moby/buildkit:v0.25.1-rootless AS buildkit


FROM node:20-alpine@sha256:afdf98210b07b586eb71fa22ba2e432e058e4cd1304d31ed60888755b8c865fb

RUN apk add --no-cache \
      git \
      rootlesskit \
      tini \
      skopeo \
  && addgroup -S worker \
  && adduser -S worker -G worker

# BuildKit
COPY --from=buildkit /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=buildkit /usr/bin/buildkitd /usr/local/bin/buildkitd
COPY --from=buildkit /usr/bin/buildctl-daemonless.sh /usr/local/bin/buildctl-daemonless.sh

# Supply-chain / Kubernetes tools
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=syft /syft /usr/local/bin/syft
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
COPY --from=kubeconform /kubeconform /usr/local/bin/kubeconform
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src

RUN mkdir -p \
      /home/worker/.local/share/buildkit \
      /tmp/platform-work \
  && chown -R worker:worker \
      /app \
      /home/worker \
      /tmp/platform-work

USER worker

ENV NODE_ENV=production \
    WORKER_HEALTH_PORT=3002 \
    BUILDKIT_COMMAND=buildctl-daemonless.sh

EXPOSE 3002

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD wget -qO- http://localhost:3002/health >/dev/null || exit 1

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["node", "src/worker/main.js"]