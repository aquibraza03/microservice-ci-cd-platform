{
  "name": "control-plane-api",
  "version": "0.2.0",
  "private": true,
  "description": "Versioned enterprise control-plane foundation",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker/main.js",
    "test": "c8 --check-coverage=false mocha \"test/unit/**/*.test.js\" --reporter spec --timeout 5000",
    "test:http": "c8 --check-coverage=false mocha \"test/integration/http.test.js\" --reporter spec --timeout 10000",
    "test:durability": "node scripts/test-durability.js",
    "test:phase1": "node scripts/test-durability.js test/integration/postgres-repository.real.test.js test/integration/durable-stores.real.test.js test/integration/part2-hardening.real.test.js test/integration/migrations.real.test.js",
    "test:postgres": "c8 --check-coverage=false mocha \"test/integration/postgres-repository.real.test.js\" --reporter spec --timeout 10000",
    "test:integration": "npm run test:http && npm run test:postgres",
    "test:migration:contract": "node test/migration.test.js",
    "test:migration:database": "mocha \"test/integration/migrations.real.test.js\" --reporter spec --timeout 10000",
    "test:migration": "npm run test:migration:contract && npm run test:migration:database",
    "migrate": "node src/database/migrate.js",
    "audit:verify": "node scripts/verify-audit-chain.js",
    "verify:phase3": "node scripts/phase3-enterprise-e2e.js",
    "verify:phase4": "node scripts/phase4-final-verification.js",
    "reliability:dataset": "node scripts/reliability/generate-dataset.js",
    "reliability:load": "node scripts/reliability/load-runner.js",
    "reliability:restore": "node scripts/reliability/restore-verify.js",
    "seed:dev": "node src/database/seed.js",
    "test:security": "mocha \"test/security/**/*.test.js\" --reporter spec --timeout 5000",
    "test:git": "mocha \"test/security/github-onboarding.test.js\" --reporter spec --timeout 5000",
    "test:deployments": "mocha \"test/deployments/**/*.test.js\" --reporter spec --timeout 10000",
    "test:detection": "mocha \"test/detection/**/*.test.js\" \"test/configuration/**/*.test.js\" --reporter spec --timeout 10000",
    "test:previews": "mocha \"test/previews/**/*.test.js\" --reporter spec --timeout 10000",
    "test:byoc": "mocha \"test/byoc/**/*.test.js\" --reporter spec --timeout 10000",
    "test:queue:redis": "mocha \"test/integration/redis-queue.real.test.js\" --reporter spec --timeout 15000",
    "test:github:live": "node test/live/github-app.acceptance.js",
    "test:ci": "npm run migrate && npm test && npm run test:http && npm run test:deployments && npm run test:detection && npm run test:queue:redis && npm run test:postgres && npm run test:migration && npm run test:security",
    "test:all": "npm test && npm run test:http && npm run test:deployments && npm run test:detection && npm run test:previews && npm run test:byoc && npm run test:security",
    "lint": "eslint src test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "5.81.5",
    "jose": "5.10.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^9.22.0",
    "mocha": "^12.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
