NODE_ENV=development
PORT=3000
SERVICE_NAME=control-plane-api
API_VERSION=v1

# demo is development-only; test is test-only. Production uses jwt or github.
AUTH_MODE=demo
CONTROL_PLANE_STORAGE=memory
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=microservice-platform-control-plane
JWT_ALGORITHMS=RS256
JWT_JWKS=
JWT_SIGNING_JWK=
JWT_CLOCK_TOLERANCE_SECONDS=5
SESSION_VALIDATION=optional

# Required only for AUTH_MODE=github. Never commit actual values.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# GitHub App for repository access (separate from platform-login OAuth).
GIT_PROVIDER_MODE=github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/app/repositories
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_MS=5000

# Required for PostgreSQL-backed deployments and migrations.
DATABASE_URL=postgres://platform_local:local_dev_pg_7f3c_change_me@localhost:55432/platform_control_plane
DB_POOL_MAX=10

# Comma-separated explicit browser origins; never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Durable deployment queue and isolated worker
REDIS_URL=redis://localhost:56379
DEPLOYMENT_QUEUE_NAME=deployments
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_MS=900000
WORKER_HEARTBEAT_MS=5000
MAX_REPOSITORY_BYTES=536870912
MAX_DEPLOYMENT_LOG_BYTES=5242880
BUILD_LOG_RETENTION_DAYS=7
BUILD_EXECUTOR_MODE=rootless-buildkit
BUILDKIT_COMMAND=buildctl-daemonless.sh
WORKER_HEALTH_PORT=3002

# Checkpoint 5 registry, supply-chain and Kubernetes providers.
# Production: ghcr. Local Kind acceptance: local. Test is forbidden in production.
REGISTRY_PROVIDER=local
LOCAL_REGISTRY_HOST=registry:5000
GHCR_OWNER=
GHCR_USERNAME=
GHCR_TOKEN=
SUPPLY_CHAIN_MODE=cli
HIGH_VULNERABILITY_POLICY=warn
ALLOW_VULNERABILITY_EXCEPTIONS=false
COSIGN_KEY_PATH=/run/secrets/cosign.key
COSIGN_PASSWORD=
COSIGN_CERTIFICATE_IDENTITY=
COSIGN_CERTIFICATE_ISSUER=
DEPLOYMENT_TARGET=kubernetes
KUBERNETES_CONTEXT=kind-platform-local
KUBERNETES_TIMEOUT_MS=300000
KIND_ENDPOINT_HOST=host.docker.internal

# Phase 3 Part 1 BYOC
AWS_PLATFORM_PRINCIPAL_ARN=
CREDENTIAL_ENCRYPTION_KEY=
METRICS_TOKEN=
OTEL_TRACES_ENDPOINT=
OTEL_EXPORT_TIMEOUT_MS=3000
OTEL_EXPORT_INTERVAL_MS=5000
# Base64-encoded 32-byte backup key from an external key manager. No development fallback.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=
RECOVERY_DATABASE_URL=
OTEL_MAX_QUEUE_SIZE=2048
OTEL_MAX_EXPORT_BATCH_SIZE=256
BYOC_VALIDATION_TIMEOUT_MS=10000
BYOC_ALLOW_PRIVATE_KUBERNETES_NETWORKS=false

# Managed-secret values are never configured here. Runtime references use the
# validated BYOC connection/target. Build secrets are unsupported.
