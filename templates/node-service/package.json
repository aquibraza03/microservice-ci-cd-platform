{
  "name": "service-test",
  "private": true,
  "scripts": {
    "test": "c8 mocha 'test/unit/**/*.js'",
    "test:ci": "c8 mocha 'test/unit/**/*.js' --reporter mocha-junit-reporter --reporter-options mochaFile=junit.xml",
    "audit": "npm audit --audit-level=high"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "check-coverage": true,
    "statements": 90,
    "lines": 90,
    "functions": 90,
    "branches": 85,
    "reporter": [
      "text",
      "json-summary",
      "html"
    ]
  },
  "overrides": {
    "glob": "^11.0.0",
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.9",
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "mocha-junit-reporter": "^2.2.1"
  }
}
