pipeline {
  agent {
    kubernetes {
      yamlFile 'jenkins/agents/k8s-pod.yaml'
      defaultContainer 'runner'
    }
  }

  options {
    skipDefaultCheckout(true)
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(
      numToKeepStr: '20',
      artifactNumToKeepStr: '10'
    ))
  }

  parameters {
    choice(name: 'ENV', choices: ['dev', 'staging', 'prod'], description: 'Deployment environment')
    booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Enable deployment')
  }

  environment {
    CI = "true"
    PLATFORM_ENV = "${params.ENV}"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Init') {
      steps {
        container('runner') {
          sh 'chmod +x ci/*.sh scripts/*.sh deploy/*.sh 2>/dev/null || true'
          sh 'if [ -f ./ci/policy.sh ]; then ./ci/policy.sh; fi'
        }
      }
    }

    stage('Detect Changed Services') {
      steps {
        container('runner') {
          sh '''
            if [ -f ./ci/detect-services.sh ]; then
              ./ci/detect-services.sh > services.txt
            else
              find services -maxdepth 1 -mindepth 1 -type d | xargs -n1 basename > services.txt
            fi
          '''
        }
        script {
          env.SERVICES = readFile('services.txt').trim()
        }
      }
    }

    stage('Build Matrix') {
      when {
        expression { return env.SERVICES }
      }

      steps {
        script {
          def services = env.SERVICES.split("\n")
          def parallelStages = [:]

          for (svc in services) {
            def serviceName = svc.trim()
            if (!serviceName) continue

            parallelStages[serviceName] = {
              stage("CI - ${serviceName}") {
                container('runner') {
                  sh """
                    export SERVICE=${serviceName}

                    if [ -f ./ci/validate-service.sh ]; then
                      ./ci/validate-service.sh ${serviceName}
                    fi

                    if [ -f ./ci/version.sh ]; then
                      ./ci/version.sh ${serviceName}
                    fi

                    if [ -f ./ci/build.sh ]; then
                      ./ci/build.sh ${serviceName}
                    fi

                    if [ -f ./ci/test.sh ]; then
                      ./ci/test.sh ${serviceName}
                    fi

                    if [ -f ./ci/security.sh ]; then
                      ./ci/security.sh ${serviceName}
                    fi
                  """
                }
              }
            }
          }

          parallel parallelStages
        }
      }
    }

    stage('Docker Build & Push') {
      steps {
        container('runner') {
          sh 'if [ -f ./ci/docker-buildx.sh ]; then ./ci/docker-buildx.sh; fi'
        }
      }
    }

    stage('Smoke Test') {
      steps {
        container('runner') {
          sh 'if [ -f ./ci/smoke-test.sh ]; then ./ci/smoke-test.sh; fi'
        }
      }
    }

    stage('Deploy') {
      when {
        allOf {
          expression { return params.DEPLOY == true }
          branch 'main'
        }
      }
      steps {
        container('runner') {
          sh "./deploy/deploy.sh ${PLATFORM_ENV}"
        }
      }
    }
  }

  post {
    success {
      echo("Pipeline succeeded")
      container('runner') {
        sh '''
          if [ -f ./scripts/notify.sh ]; then
            ./scripts/notify.sh success "Monorepo CI pipeline succeeded"
          fi
        '''
      }
    }
    failure {
      echo("Pipeline failed")
      container('runner') {
        sh '''
          if [ -f ./scripts/notify.sh ]; then
            ./scripts/notify.sh failure "Monorepo CI pipeline failed"
          fi
        '''
      }
    }
    always {
      junit(
        allowEmptyResults: true,
        testResults: '**/test-results.xml'
      )
      archiveArtifacts(
        artifacts: 'services.txt',
        fingerprint: true,
        allowEmptyArchive: true
      )
      script {
        currentBuild.description = "Monorepo CI | ${params.ENV}"
      }
    }
  }
}
