@Library('platform-shared-library') _

import org.platform.Notifications
import org.platform.Governance
import org.platform.Utils

pipeline {
  agent {
    kubernetes {
      yamlFile 'jenkins/agents/k8s-pod.yaml'
      defaultContainer 'runner'
    }
  }

  options {
    skipDefaultCheckout(true)
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(
      numToKeepStr: '20',
      artifactNumToKeepStr: '10'
    ))
  }

  parameters {
    choice(
      name: 'ENV',
      choices: ['dev', 'staging', 'prod'],
      description: 'Target deployment environment'
    )
    string(
      name: 'SERVICE',
      defaultValue: '',
      description: 'Service name under services/'
    )
    string(
      name: 'IMAGE_REF',
      defaultValue: '',
      description: 'Optional image tag or immutable digest'
    )
    booleanParam(
      name: 'AUTO_ROLLBACK',
      defaultValue: true,
      description: 'Rollback automatically if deployment fails'
    )
  }

  environment {
    CI = "true"
    PLATFORM_ENV = "${params.ENV}"
    SERVICE_NAME = "${params.SERVICE}"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Validate Inputs') {
      steps {
        script {
          def utils = new Utils(this)

          if (!params.SERVICE?.trim()) {
            error("SERVICE parameter is required")
          }

          utils.requireService(params.SERVICE)

          env.IMAGE = params.IMAGE_REF?.trim()

          if (!env.IMAGE) {
            env.IMAGE = utils.shOut('./ci/version.sh')
          }

          if (!env.IMAGE) {
            error("Unable to resolve IMAGE_REF")
          }

          utils.setDescription("${params.SERVICE} | ${params.ENV} | ${env.IMAGE}")
        }
      }
    }

    stage('Governance Checks') {
      steps {
        script {
          def gov = new Governance(this)
          gov.validateDeploy(params.SERVICE, params.ENV)
        }
      }
    }

    stage('Policy Checks') {
      steps {
        container('runner') {
          sh '''
            chmod +x ci/*.sh deploy/*.sh scripts/*.sh 2>/dev/null || true
            if [ -f ./ci/policy.sh ]; then
              ./ci/policy.sh
            fi
          '''
        }
      }
    }

    stage('Pre-Deploy Validation') {
      steps {
        container('runner') {
          sh """
            if [ -f ./ci/validate-service.sh ]; then
              ./ci/validate-service.sh ${SERVICE_NAME}
            fi
          """
        }
      }
    }

    stage('Production Approval') {
      when {
        expression { params.ENV == 'prod' }
      }
      steps {
        script {
          def notifier = new Notifications(this)
          notifier.approvalNeeded("Deployment of ${params.SERVICE} to PROD")
        }
        timeout(time: 20, unit: 'MINUTES') {
          input(
            message: "Approve deployment of ${params.SERVICE} to PROD?",
            ok: "Deploy"
          )
        }
      }
    }

    stage('Deploy') {
      steps {
        container('runner') {
          retry(2) {
            sh """
              export SERVICE=${SERVICE_NAME}
              export IMAGE_REF=${IMAGE}
              ./deploy/deploy.sh ${PLATFORM_ENV}
            """
          }
        }
      }
    }

    stage('Smoke Test') {
      steps {
        container('runner') {
          sh """
            if [ -f ./ci/smoke-test.sh ]; then
              ./ci/smoke-test.sh ${SERVICE_NAME}
            fi
          """
        }
      }
    }
  }

  post {

    success {
      script {
        def notifier = new Notifications(this)
        notifier.success("Deployment: ${SERVICE_NAME} -> ${PLATFORM_ENV} (${IMAGE})")
      }

      container('runner') {
        sh """
          if [ -f ./scripts/notify.sh ]; then
            ./scripts/notify.sh success \
            "Deployment successful: ${SERVICE_NAME} -> ${PLATFORM_ENV} (${IMAGE})"
          fi
        """
      }
    }

    failure {
      echo("Deployment failed")

      script {
        def notifier = new Notifications(this)
        notifier.failure("Deployment failed: ${SERVICE_NAME} -> ${PLATFORM_ENV}")

        if (params.AUTO_ROLLBACK) {
          container('runner') {
            sh """
              if [ -f ./deploy/k8s/rollback.sh ]; then
                NAMESPACE=${SERVICE_NAME} ROLLOUT_TIMEOUT=300s ./deploy/k8s/rollback.sh ${SERVICE_NAME}
              elif [ -f ./deploy/rollback.sh ]; then
                ./deploy/rollback.sh ${PLATFORM_ENV} ${SERVICE_NAME}
              fi
            """
          }
        }
      }
    }

    always {
      archiveArtifacts(
        artifacts: 'services.txt',
        allowEmptyArchive: true
      )

      script {
        currentBuild.description =
          "${params.SERVICE} | ${params.ENV} | ${env.IMAGE}"
      }
    }
  }
}
