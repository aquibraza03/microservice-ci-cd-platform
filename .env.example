IMAGE_REGISTRY=local
IMAGE_TAG=dev

K8S_NAMESPACE=dev
CREATE_NAMESPACE=true

ENVIRONMENT=dev
SERVICE_TYPE=ClusterIP
SERVICE_PORT=80
CONTAINER_PORT=3000

REPLICAS=1
HEALTH_PATH=/health
READINESS_PATH=/ready

CPU_REQUEST=100m
MEMORY_REQUEST=128Mi
CPU_LIMIT=500m
MEMORY_LIMIT=256Mi

ENABLE_HPA=true
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=3
HPA_CPU_UTILIZATION=80

ENABLE_PDB=true
PDB_MIN_AVAILABLE=1

ENABLE_NETWORK_POLICY=true
