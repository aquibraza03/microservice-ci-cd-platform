IMAGE_REGISTRY=local
IMAGE_TAG=dev

K8S_NAMESPACE=dev
CREATE_NAMESPACE=true

ENVIRONMENT=dev
SERVICE_TYPE=ClusterIP
SERVICE_PORT=80
CONTAINER_PORT=3000

REPLICAS=1
HEALTH_PATH=/health
READINESS_PATH=/ready

CPU_REQUEST=100m
MEMORY_REQUEST=128Mi
CPU_LIMIT=500m
MEMORY_LIMIT=256Mi

ENABLE_HPA=true
HPA_MIN_REPLICAS=1
HPA_MAX_REPLICAS=3
HPA_CPU_UTILIZATION=80

ENABLE_PDB=true
PDB_MIN_AVAILABLE=1

ENABLE_NETWORK_POLICY=true

# Phase 3 BYOC. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Separate externally managed HMAC key. Generate with: openssl rand -base64 32
AUDIT_INTEGRITY_KEY=

# Phase 4 observability. Production uses an internal TLS collector endpoint.
METRICS_TOKEN=
OTEL_TRACES_ENDPOINT=
OTEL_EXPORT_TIMEOUT_MS=3000
OTEL_EXPORT_INTERVAL_MS=5000
# Backup/restore credentials are injected by the scheduler or key manager; never commit values.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=
RECOVERY_DATABASE_URL=
OTEL_MAX_QUEUE_SIZE=2048
OTEL_MAX_EXPORT_BATCH_SIZE=256
AWS_PLATFORM_PRINCIPAL_ARN=
BYOC_VALIDATION_TIMEOUT_MS=10000
# Development/test only; production rejects private resolved addresses.
BYOC_ALLOW_PRIVATE_KUBERNETES_NETWORKS=false

# Phase 3 Part 2 stores external references only. Do not place provider secret
# plaintext here. Build-time secret injection is intentionally unsupported.

# Local control-plane dependencies (examples only; change for shared systems)
POSTGRES_USER=platform_local
POSTGRES_PASSWORD=local_dev_pg_7f3c_change_me
POSTGRES_DB=platform_control_plane
POSTGRES_PORT=55432
REDIS_PORT=56379
REGISTRY_PORT=5001
CONTROL_PLANE_PORT=3001
DATABASE_URL=postgres://platform_local:local_dev_pg_7f3c_change_me@localhost:55432/platform_control_plane
REDIS_URL=redis://localhost:56379
LOCAL_REGISTRY=localhost:5001
REGISTRY_PROVIDER=local
LOCAL_REGISTRY_HOST=registry:5000
KUBECONFIG_PATH=../.local/kubeconfig
COSIGN_KEY_PATH=../.local/cosign.key
LOCAL_COSIGN_PASSWORD=local_cosign_9c7e_change_me
# Billing remains disabled by default. Enabling a production consumer requires
# a migration-backed usage repository, an authenticated worker, and completed
# restore/contention evidence; no payment-provider credentials are accepted.
BILLING_USAGE_CONSUMER_ENABLED=false
BILLING_TIMEZONE=UTC
